# Copy this file to .env for local Docker usage. Do not commit real secrets.

DB_NAME=recallpath
DB_USER=recallpath
DB_PASSWORD=change_me
DB_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Frontend development container. Use the Compose backend service internally.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8080
CHOKIDAR_USEPOLLING=true

# Optional pgAdmin profile.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050
